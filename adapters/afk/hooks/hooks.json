{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/session-start.ts",
            "timeout_ms": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/prompt-router.ts",
            "timeout_ms": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "/^agent$/",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/subagent-router.ts",
            "timeout_ms": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "/edit_file|write_file|patch_apply/",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/rules.ts",
            "timeout_ms": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types ${CLAUDE_PLUGIN_ROOT}/src/stop-sweep.ts",
            "timeout_ms": 15000
          }
        ]
      }
    ]
  }
}
