{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/session-start.js",
            "timeout_ms": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/prompt-router.js",
            "timeout_ms": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "/^agent$/",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/subagent-router.js",
            "timeout_ms": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "/edit_file|write_file|patch_apply/",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/rules.js",
            "timeout_ms": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/stop-sweep.js",
            "timeout_ms": 15000
          }
        ]
      }
    ]
  }
}
