#!/usr/bin/env bash
# Harness for project-local verification of claude-jev.
# Isolates every run under VERIFY_HOME=/tmp/jev-verify-$RUN_ID so live
# ~/.claude logs and caches are never touched. Child processes see that
# path as HOME; the caller's HOME is left alone. Evidence lives under the
# skill's artifacts/ tree and must survive cleanup.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ARTIFACTS_ROOT="$(realpath -m "${JE_VERIFY_EVIDENCE:-$SKILL_DIR/artifacts}")"

usage() {
  cat <<'EOF'
Usage: control-jev <command> [args]

  launch [--reuse]    Create an isolated VERIFY_HOME and record the run id
  doctor              Read-only health check for the active run
  env                 Print exportable assignments for eval "$(control-jev env)"
  cleanup             Tear down the disposable home; keep evidence
  status              Print the active RUN_ID, VERIFY_HOME, and evidence dir
  hook <name> [json]  Drive one hook with a JSON event on stdin or as arg
  rows [json-file]    Drive compactor.py rows (stdin or file)
  jev -- <args...>    Run scripts/jev.py with the isolated env
  stats [-- args...]  Run scripts/stats.py with the isolated env
  evidence <relpath>  Print the absolute evidence path for this run
  save <relpath> -    Write stdin to evidence/<relpath> (creates parents)

Environment:
  JE_VERIFY_RUN_ID     Force the run id on launch (default: timestamp-pid);
                       must match [A-Za-z0-9._-]+
  JE_VERIFY_EVIDENCE   Override evidence root (default: skill artifacts/)
  TYPESAFE_API_KEY     Optional; without it hooks fail open and jev exits 2
  XDG_RUNTIME_DIR      Preferred private dir for the active-run state file;
                       if unset, uses /tmp/jev-verify-control-<uid> mode 0700

State is a validated RUN_ID line only — never sourced as shell. Prefer
eval "$(control-jev env)" for recipe vars; that does not export HOME.
EOF
}

die() { echo "control-jev: $*" >&2; exit 1; }

# Private state directory: XDG_RUNTIME_DIR when set, else a 0700 per-uid dir.
# Never fall back to world-writable /tmp/jev-verify-control.
ensure_state_dir() {
  local uid owner
  uid="$(id -u)"
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    [[ -d "$XDG_RUNTIME_DIR" ]] || die "XDG_RUNTIME_DIR is not a directory: $XDG_RUNTIME_DIR"
    owner="$(stat -c '%u' "$XDG_RUNTIME_DIR" 2>/dev/null || stat -f '%u' "$XDG_RUNTIME_DIR")"
    [[ "$owner" == "$uid" ]] || die "XDG_RUNTIME_DIR not owned by current user"
    STATE_DIR="$XDG_RUNTIME_DIR/jev-verify-control"
  else
    STATE_DIR="/tmp/jev-verify-control-$uid"
  fi
  if [[ -e "$STATE_DIR" ]]; then
    [[ -d "$STATE_DIR" ]] || die "state path exists and is not a directory: $STATE_DIR"
    [[ ! -L "$STATE_DIR" ]] || die "state dir must not be a symlink: $STATE_DIR"
    owner="$(stat -c '%u' "$STATE_DIR" 2>/dev/null || stat -f '%u' "$STATE_DIR")"
    [[ "$owner" == "$uid" ]] || die "state dir not owned by current user: $STATE_DIR"
    chmod 700 "$STATE_DIR"
  else
    mkdir -m 700 "$STATE_DIR"
  fi
  STATE_FILE="$STATE_DIR/active-run"
}

validate_run_id() {
  local id="$1"
  [[ -n "$id" ]] || die "empty RUN_ID"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] || die "RUN_ID must match [A-Za-z0-9._-]+ (got: $id)"
  [[ "$id" != *..* ]] || die "RUN_ID must not contain .. (got: $id)"
}

# True when resolved path $1 is exactly $2 or a file under it.
path_under() {
  local resolved="$1"
  local base="$2"
  [[ "$resolved" == "$base" || "$resolved" == "$base"/* ]]
}

# VERIFY_HOME must be exactly /tmp/jev-verify-$RUN_ID (no symlink escape).
# EVIDENCE_DIR must resolve under ARTIFACTS_ROOT as ARTIFACTS_ROOT/$RUN_ID.
assert_run_paths() {
  validate_run_id "$RUN_ID"
  local expected="/tmp/jev-verify-$RUN_ID"
  [[ -n "${VERIFY_HOME:-}" ]] || die "VERIFY_HOME unset"
  [[ -n "${EVIDENCE_DIR:-}" ]] || die "EVIDENCE_DIR unset"
  [[ "$VERIFY_HOME" == "$expected" ]] || die "VERIFY_HOME must be $expected (got: $VERIFY_HOME)"
  [[ "$VERIFY_HOME" != *..* ]] || die "VERIFY_HOME must not contain .. (got: $VERIFY_HOME)"
  if [[ -e "$VERIFY_HOME" || -L "$VERIFY_HOME" ]]; then
    [[ ! -L "$VERIFY_HOME" ]] || die "VERIFY_HOME must not be a symlink (got: $VERIFY_HOME)"
    [[ -d "$VERIFY_HOME" ]] || die "VERIFY_HOME exists and is not a directory: $VERIFY_HOME"
    local resolved
    resolved="$(realpath "$VERIFY_HOME")"
    [[ "$resolved" == "$expected" ]] || die "resolved VERIFY_HOME $resolved != $expected"
  fi
  local expected_ev artifacts_resolved ev_resolved
  artifacts_resolved="$(realpath -m "$ARTIFACTS_ROOT")"
  expected_ev="$(realpath -m "$ARTIFACTS_ROOT/$RUN_ID")"
  ev_resolved="$(realpath -m "$EVIDENCE_DIR")"
  [[ "$ev_resolved" == "$expected_ev" ]] || die "EVIDENCE_DIR must be $expected_ev (got: $EVIDENCE_DIR -> $ev_resolved)"
  path_under "$ev_resolved" "$artifacts_resolved" || die "EVIDENCE_DIR escapes ARTIFACTS_ROOT"
}

# Parse state file: only RUN_ID=<safe> lines. Never source as shell.
# Paths are derived, not trusted from disk.
load_state() {
  ensure_state_dir
  [[ -f "$STATE_FILE" ]] || return 1
  [[ ! -L "$STATE_FILE" ]] || die "state file must not be a symlink"
  local line val found=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    case "$line" in
      RUN_ID=*)
        val="${line#RUN_ID=}"
        validate_run_id "$val"
        RUN_ID="$val"
        found=1
        ;;
      *)
        die "invalid state line (only RUN_ID= allowed): $line"
        ;;
    esac
  done <"$STATE_FILE"
  [[ "$found" -eq 1 ]] || die "state file missing RUN_ID"
  VERIFY_HOME="/tmp/jev-verify-$RUN_ID"
  EVIDENCE_DIR="$ARTIFACTS_ROOT/$RUN_ID"
  assert_run_paths
  return 0
}

write_state() {
  ensure_state_dir
  assert_run_paths
  mkdir -p "$VERIFY_HOME" "$EVIDENCE_DIR"
  # Single validated assignment — no shell metacharacters in RUN_ID.
  printf 'RUN_ID=%s\n' "$RUN_ID" >"$STATE_FILE"
  chmod 600 "$STATE_FILE"
}

# Run a command with the disposable home as HOME for that process only.
with_verify_home() {
  assert_run_paths
  env HOME="$VERIFY_HOME" CLAUDE_PLUGIN_ROOT="$ROOT" "$@"
}

require_active() {
  ensure_state_dir
  if [[ -n "${RUN_ID:-}" && -n "${VERIFY_HOME:-}" && -n "${EVIDENCE_DIR:-}" ]]; then
    assert_run_paths
    [[ -d "$VERIFY_HOME" ]] || die "VERIFY_HOME missing for RUN_ID=$RUN_ID; re-launch"
    return 0
  fi
  load_state || die "no active run; run: control-jev launch"
  [[ -d "$VERIFY_HOME" ]] || die "VERIFY_HOME missing for RUN_ID=$RUN_ID; re-launch"
}

# Refuse absolute paths and any .. path component; require dest under base.
evidence_dest() {
  local base="$1"
  local rel="$2"
  [[ -n "$rel" ]] || die "relative evidence path required"
  [[ "$rel" != /* ]] || die "evidence path must be relative (got absolute: $rel)"
  case "/$rel/" in
    */../*) die "evidence path must not contain .. (got: $rel)" ;;
  esac
  local dest="$base/$rel"
  local resolved base_resolved
  resolved="$(realpath -m "$dest")"
  base_resolved="$(realpath -m "$base")"
  path_under "$resolved" "$base_resolved" || die "evidence path escapes $base (got: $rel)"
  printf '%s\n' "$dest"
}

cmd_launch() {
  ensure_state_dir
  if [[ "${1:-}" == "--reuse" ]]; then
    load_state || die "no state to reuse; run: control-jev launch"
    mkdir -p "$VERIFY_HOME" "$EVIDENCE_DIR"
  else
    RUN_ID="${JE_VERIFY_RUN_ID:-$(date +%Y%m%d-%H%M%S)-$$}"
    validate_run_id "$RUN_ID"
    VERIFY_HOME="/tmp/jev-verify-$RUN_ID"
    EVIDENCE_DIR="$ARTIFACTS_ROOT/$RUN_ID"
    mkdir -p "$VERIFY_HOME" "$EVIDENCE_DIR"
  fi
  assert_run_paths
  write_state
  cat <<EOF
run_id=$RUN_ID
home=$VERIFY_HOME
plugin_root=$ROOT
evidence_dir=$EVIDENCE_DIR
ready=1
EOF
}

cmd_doctor() {
  require_active
  local ok=1
  local report="$EVIDENCE_DIR/doctor.txt"
  mkdir -p "$EVIDENCE_DIR"
  {
    echo "run_id=$RUN_ID"
    echo "home=$VERIFY_HOME"
    echo "plugin_root=$ROOT"
    echo "python=$(python3 --version 2>&1)"
    echo "typesafe_api_key=$([ -n "${TYPESAFE_API_KEY:-}" ] && echo set || echo unset)"
  } >"$report"

  if ! python3 -m compileall -q "$ROOT/scripts" "$ROOT/eval"; then
    echo "compileall=fail" | tee -a "$report"
    ok=0
  else
    echo "compileall=ok" | tee -a "$report"
  fi

  local exitc out
  set +e
  out="$(printf '' | with_verify_home python3 "$ROOT/scripts/prompt_router.py" 2>&1)"
  exitc=$?
  set -e
  echo "prompt_router_empty_exit=$exitc" | tee -a "$report"
  [[ "$exitc" -eq 0 && -z "$out" ]] || ok=0

  set +e
  out="$(printf '' | with_verify_home python3 "$ROOT/scripts/compactor.py" rows 2>&1)"
  exitc=$?
  set -e
  echo "compactor_rows_empty_exit=$exitc" | tee -a "$report"
  echo "compactor_rows_empty_out=$out" | tee -a "$report"
  [[ "$exitc" -eq 0 && "$out" == *'"fallback"'* ]] || ok=0

  set +e
  out="$(with_verify_home python3 "$ROOT/scripts/comparators.py" which 2>&1)"
  set -e
  echo "comparators_which=$out" | tee -a "$report"

  if [[ ! -d "$VERIFY_HOME" ]]; then
    echo "home_missing=1" | tee -a "$report"
    ok=0
  else
    echo "home_ok=1" | tee -a "$report"
  fi

  if [[ "$ok" -eq 1 ]]; then
    echo "doctor=ok" | tee -a "$report"
    return 0
  fi
  echo "doctor=fail" | tee -a "$report"
  return 1
}

cmd_cleanup() {
  require_active
  local home_to_remove="$VERIFY_HOME"
  local run="$RUN_ID"
  local evidence="$EVIDENCE_DIR"
  local expected="/tmp/jev-verify-$run"
  assert_run_paths
  [[ "$home_to_remove" == "$expected" ]] || die "VERIFY_HOME must be $expected (got: $home_to_remove)"
  [[ ! -L "$home_to_remove" ]] || die "refusing to remove symlink VERIFY_HOME=$home_to_remove"
  if [[ -e "$home_to_remove" ]]; then
    local resolved
    resolved="$(realpath "$home_to_remove")"
    [[ "$resolved" == "$expected" ]] || die "resolved VERIFY_HOME $resolved != $expected (symlink escape?)"
  fi
  rm -rf -- "$home_to_remove"
  rm -f -- "$STATE_FILE"
  cat <<EOF
cleaned_home=$home_to_remove
run_id=$run
evidence_dir=$evidence
evidence_kept=$([ -d "$evidence" ] && echo 1 || echo 0)
EOF
}

cmd_status() {
  require_active
  cat <<EOF
run_id=$RUN_ID
home=$VERIFY_HOME
plugin_root=$ROOT
evidence_dir=$EVIDENCE_DIR
api_key=$([ -n "${TYPESAFE_API_KEY:-}" ] && echo set || echo unset)
EOF
}

# Print shell assignments recipes can eval. Always includes CLAUDE_PLUGIN_ROOT
# (from this checkout). After launch, also exports RUN_ID / VERIFY_HOME /
# EVIDENCE_DIR. Does not export HOME — that would replace the caller's home.
cmd_env() {
  ensure_state_dir
  printf 'export CLAUDE_PLUGIN_ROOT=%q\n' "$ROOT"
  if [[ -n "${RUN_ID:-}" && -n "${VERIFY_HOME:-}" && -n "${EVIDENCE_DIR:-}" ]]; then
    assert_run_paths
  elif load_state; then
    :
  else
    return 0
  fi
  printf 'export RUN_ID=%q\n' "$RUN_ID"
  printf 'export VERIFY_HOME=%q\n' "$VERIFY_HOME"
  printf 'export EVIDENCE_DIR=%q\n' "$EVIDENCE_DIR"
}

cmd_hook() {
  require_active
  local name="${1:-}"
  shift || true
  case "$name" in
    prompt_router|subagent_router|rules) ;;
    "") die "hook name required (prompt_router|subagent_router|rules)" ;;
    *) die "hook name must be prompt_router|subagent_router|rules (got: $name)" ;;
  esac
  local script="$ROOT/scripts/${name}.py"
  [[ -f "$script" ]] || die "unknown hook script: $script"
  if [[ $# -gt 0 ]]; then
    printf '%s\n' "$1" | with_verify_home python3 "$script"
  else
    with_verify_home python3 "$script"
  fi
}

cmd_rows() {
  require_active
  if [[ $# -gt 0 ]]; then
    with_verify_home python3 "$ROOT/scripts/compactor.py" rows <"$1"
  else
    with_verify_home python3 "$ROOT/scripts/compactor.py" rows
  fi
}

cmd_jev() {
  require_active
  if [[ "${1:-}" == "--" ]]; then shift; fi
  with_verify_home python3 "$ROOT/scripts/jev.py" "$@"
}

cmd_stats() {
  require_active
  if [[ "${1:-}" == "--" ]]; then shift; fi
  with_verify_home python3 "$ROOT/scripts/stats.py" "$@"
}

cmd_evidence() {
  require_active
  local rel="${1:-}"
  evidence_dest "$EVIDENCE_DIR" "$rel"
}

cmd_save() {
  require_active
  local rel="${1:-}"
  local dash="${2:-}"
  [[ -n "$rel" && "$dash" == "-" ]] || die "usage: control-jev save <relpath> -"
  local dest
  dest="$(evidence_dest "$EVIDENCE_DIR" "$rel")"
  mkdir -p "$(dirname "$dest")"
  cat >"$dest"
  echo "saved=$dest"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    env) cmd_env "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    status) cmd_status "$@" ;;
    hook) cmd_hook "$@" ;;
    rows) cmd_rows "$@" ;;
    jev) cmd_jev "$@" ;;
    stats) cmd_stats "$@" ;;
    evidence) cmd_evidence "$@" ;;
    save) cmd_save "$@" ;;
    -h|--help|help|"") usage; [[ -n "$cmd" ]] || exit 2 ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
